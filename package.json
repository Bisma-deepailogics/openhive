{
  "name": "openhive",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source team messaging platform — Electron desktop app shell",
  "author": {
    "name": "OpenHive",
    "email": "bisma.haseeb@deepailogics.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:prepare": "npm install --prefix electron --ignore-scripts --no-audit --no-fund",
    "electron:build": "npm run electron:prepare && electron-builder --publish never",
    "electron:build:mac": "npm run electron:prepare && electron-builder --mac --publish never",
    "electron:build:win": "npm run electron:prepare && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-mention": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/dompurify": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "emoji-picker-react": "^4.19.1",
    "livekit-client": "^2.22.1",
    "livekit-server-sdk": "^2.18.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.deepailogics.openhive",
    "productName": "OpenHive",
    "asar": true,
    "protocols": [
      {
        "name": "OpenHive",
        "schemes": [
          "openhive"
        ]
      }
    ],
    "directories": {
      "app": "electron",
      "output": "dist-electron",
      "buildResources": "electron/build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenHive"
    }
  }
}
